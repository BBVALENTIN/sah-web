{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "rootDir": "src/main/resources/static/ts",

    "outDir": "src/main/resources/static/ts-transpiled",
    "allowJs": true, // pentru sound manager
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/main/resources/static/ts/**/*"],
  "exclude": ["src/main/resources/static/js/chess-related/audio/soundManager.js"]
}