{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "rootDir": "src/main/resources/static/ts",
    "outDir": "src/main/resources/static/ts-transpiled",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/main/resources/static/ts/**/*.ts"],
}